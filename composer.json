{
    "name": "yangweijie/typephp-gpui",
    "description": "Native desktop GUI framework for PHP: TypePHP (AOT) + gpui-kit-cpp. Declarative element tree, GPU-accelerated rendering, one-command build.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "typephp",
        "aot",
        "gpui",
        "gpui-kit",
        "desktop",
        "gui",
        "native",
        "php",
        "cross-platform"
    ],
    "require": {
        "php": ">=8.1",
        "swoole/php-nano": "^1.1"
    },
    "require-dev": {
        "pestphp/pest": "^5.3",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0",
        "swoole/typephp": ">=0.9"
    },
    "autoload": {
        "psr-4": {
            "TypePHP\\Gpui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TypePHP\\Gpui\\Tests\\": "tests/"
        },
        "files": [
            "src/FakeBridge.php"
        ]
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "test:cpp": "bash cmd/test-shim.sh",
        "parity:upstream": "@php cmd/check-upstream-parity.php",
        "test:all": [
            "@php vendor/bin/pest",
            "@php vendor/bin/phpstan analyse --no-progress",
            "@php cmd/check-upstream-parity.php",
            "bash cmd/test-shim.sh"
        ],
        "patch": "@php bin/gpui patch",
        "bootstrap": "@php bin/gpui build",
        "build": "@php bin/gpui build",
        "run": "@php bin/gpui run",
        "doctor": "@php bin/gpui doctor",
        "shot:check": "@php bin/gpui shotdiff check",
        "shot:record": "@php bin/gpui shotdiff record",
        "examples:all": "bash cmd/all-examples.sh",
        "demo:build": "@php bin/gpui build hello"
    },
    "bin": [
        "bin/gpui"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "bridge": {
            "stub": "php-src/gpui.stub.php",
            "sources": [
                "cpp-src",
                "php-src"
            ],
            "gpui-kit-dir": "build/gpui-kit-cpp"
        }
    }
}
