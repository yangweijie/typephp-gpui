#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * gpui — TypePHP-GPUI 打包 CLI。
 *
 * 用法：
 *   gpui doctor              检查工具链（bun / clang / tpc / php-nano / frameworks）
 *   gpui build [example]     按序跑补丁 → 生成 amalgam → 建 shim 库 → tpc nano 编译
 *   gpui run [example]       编译并运行示例（默认 hello）
 *   gpui shot [example]      编译并 --shot 出 PNG（默认 /tmp/<example>.png）
 *   gpui selftest [example]  编译并跑 --selftest，rc=0 即通过
 *   gpui new <app>           脚手架一个新应用（project.macos.yml + src/main.php）
 *
 * 约定：项目根 = 本文件所在仓库根（bin/ 的上级）。示例在 examples/<name>/。
 */

$root = dirname(__DIR__);
// 交付身份的解析是纯函数、且要被 Pest 单测覆盖，所以放 cmd/ 下当库文件。
require_once __DIR__ . '/../cmd/bundle-identity.php';
$argvv = $argv;
array_shift($argvv);
$cmd = $argvv[0] ?? 'help';
$args = array_slice($argvv, 1);

function out(string $s): void { fwrite(STDOUT, $s . "\n"); }
function err(string $s): void { fwrite(STDERR, $s . "\n"); }
function ok(string $s): void { out("  \033[32m✓\033[0m $s"); }
function bad(string $s): void { $GLOBALS["gpui_bad_n"] = (int) ($GLOBALS["gpui_bad_n"] ?? 0) + 1;
    out("  \033[31m✗\033[0m $s"); }

function which(string $bin): ?string {
    $p = trim((string) @shell_exec('command -v ' . escapeshellarg($bin) . ' 2>/dev/null'));
    return $p !== '' ? $p : null;
}

function run(string $cmd, ?string $cwd = null): int {
    out("\033[2m$ $cmd\033[0m");
    passthru($cmd, $code);
    return $code;
}

// gpui-kit-cpp 源码目录：GPUI_DIR 环境变量优先，否则 vendor/gpui-kit-cpp。
// 上游无 git 历史，无法用 submodule/SHA 钉版，故以「补丁 marker 校验 + 契约文档」
// 保证可复现：doctor 与 build 都会确认所有补丁已落。
function gpuiDir(): string {
    global $root;
    $d = getenv('GPUI_DIR');
    return ($d !== false && $d !== '') ? rtrim($d, '/') : "$root/build/gpui-kit-cpp";
}

// 每个补丁 → 目标文件 → 幂等 marker（与 cmd/patch-*.sh 的 MARK 保持一致）。
// 缺任一 marker 说明源码半补丁状态，build.ts 会编出行为不对的 amalgam。
function patchManifest(): array {
    global $root;
    $gpui = gpuiDir();
    $nano = getenv('NANO_DIR');
    $nano = ($nano !== false && $nano !== '') ? rtrim($nano, '/') : "$root/vendor/swoole/php-nano";
    return [
        ['patch-nano.sh',          "$nano/src/extension.cpp",        'Engine-provided modules'],
        ['patch-view.sh',          "$gpui/src/shell/view.cpp",       '/* typephp-gpui: patched */'],
        ['patch-retained.sh',      "$gpui/src/shell/runtime.cpp",    'CreateRetainedInput'],
        ['patch-retained.sh',      "$gpui/src/shell/runtime.cpp",    'CreateRetainedOtp'],
        ['patch-focus.sh',         "$gpui/src/shell/runtime.cpp",    'CreateRetainedFocus'],
        ['patch-registered-cb.sh', "$gpui/src/shell/runtime.cpp",    'PushShimCallback'],
        ['patch-dispatch-cb.sh',   "$gpui/src/shell/runtime.cpp",    'typephp-gpui: shim route (DispatchArgs)'],
        ['patch-nested-view.sh',   "$gpui/src/shell/runtime.cpp",    'RegisterHostView'],
        ['patch-host-application.sh', "$gpui/src/shell/runtime.cpp", 'HostApplyComponentAppEffect'],
        ['patch-host-state.sh',      "$gpui/src/shell/runtime.cpp", 'typephp-gpui: host-side retained component state'],
        ['patch-host-state.sh',      "$gpui/src/shell/runtime.h",   'NewHostState'],
        ['patch-host-list.sh',       "$gpui/src/shell/runtime.cpp", 'typephp-gpui: host-rendered virtual list'],
        ['patch-host-dock.sh',       "$gpui/src/shell/runtime.cpp", 'ShellRuntime::CreateHostDock'],
        ['patch-host-dock.sh',       "$gpui/src/shell/runtime.h",   'bool ReleaseHostDock(shell::EntityHandle handle);'],
        ['patch-host-dock.sh',       "$gpui/src/base/dock_state.cpp", 'typephp-gpui: release Dock layout node arrays'],
        ['patch-host-dock.sh',       "$gpui/src/shell/dock.h",      'const DockRenderer* hostRenderer = nullptr;'],
        ['patch-host-dock.sh',       "$gpui/src/shell/dock.cpp",    'typephp-gpui: delegate the complete native Dock renderer.'],
        ['patch-concepts.sh',      "$gpui/src/gpui/gpui.h",          'EmitsEventV'],
        ['patch-hover-always.sh',  "$gpui/src/gpui/window_mac.cpp",  'NSTrackingActiveAlways'],
        ['patch-window-handle.sh', "$gpui/src/gpui/platform.h",      'WindowNativeHandle'],
        ['patch-window-handle.sh', "$gpui/src/gpui/window_mac.cpp",  'typephp-gpui: expose the owning NSWindow'],
        ['patch-key-view.sh',      "$gpui/src/shell/view.cpp",       'typephp-gpui: gpuiEnqueueKey'],
        ['patch-mouse-view.sh',    "$gpui/src/shell/view.cpp",       'typephp-gpui: gpuiEnqueueMouse'],
        ['patch-select-view.sh',   "$gpui/src/shell/view.cpp",       'typephp-gpui: gpuiEnqueueSignal'],
        ['patch-resize-handle.sh', "$gpui/src/base/resizable.cpp",   'typephp-gpui: resize probe'],
        ['patch-resize-handle.sh', "$gpui/src/shell/materialize.cpp", 'typephp-gpui: host resize route'],
        ['patch-resize-handle.sh', "$gpui/src/base/resizable.h",      'typephp-gpui: wide grab band'],
        ['patch-resize-handle.sh', "$gpui/src/gpui/window_mac.cpp",   'typephp-gpui: resize down probe'],
        ['patch-input-focus.sh',   "$gpui/src/shell/materialize.cpp",  'typephp-gpui: input takes press'],
        ['patch-input-focus.sh',   "$gpui/src/ui/input.cpp",           'typephp-gpui: input takes press'],
        ['patch-time-field-press.sh', "$gpui/src/base/time_field.cpp", 'typephp-gpui: time field takes press'],
        ['patch-popup-occlude.sh', "$gpui/src/ui/popover.cpp",         'typephp-gpui: popup occludes'],
        ['patch-popup-occlude.sh', "$gpui/src/ui/time.cpp",            'typephp-gpui: popup occludes'],
        ['patch-popup-same-frame.sh', "$gpui/src/base/popup.cpp",      'typephp-gpui: popup mounts same frame'],
        ['patch-number-center.sh', "$gpui/src/shell/materialize.cpp",  'typephp-gpui: number input centers digits'],
        ['patch-shell-checkbox.sh', "$gpui/src/shell/materialize.cpp", 'typephp-gpui: checkbox/switch use themed component'],
        ['patch-checkbox-click-id.sh', "$gpui/src/shell/materialize.cpp", 'typephp-gpui: checkbox click id = callback id'],
        ['patch-shell-textarea-frame.sh', "$gpui/src/shell/materialize.cpp", 'typephp-gpui: shell textarea themed frame'],
        ['patch-progress-circle.sh', "$gpui/src/component_shell/compound/progress.cpp", 'kProgressCircle'],
        ['patch-popup-menu.sh',     "$gpui/src/component_shell/overlays/popup_menu.cpp", 'RegisterOverlaysPopupMenu'],
        ['patch-popup-menu.sh',     "$gpui/src/component_shell/overlays/mod.cpp", 'RegisterOverlaysPopupMenu'],
        ['patch-element-arg.sh',    "$root/cpp-src/gpui_bridge.cc", 'typephp-gpui: element arg bridge'],
        ['patch-host-data.sh',      "$gpui/src/shell/runtime.cpp", 'typephp-gpui: host data loop'],
        ['patch-token-render.sh',   "$gpui/src/shell/runtime.cpp", 'typephp-gpui: host-rendered inline token'],
        ['patch-host-element-cb.sh', "$gpui/src/shell/runtime.cpp", 'typephp-gpui: host element callback'],
        ['patch-candlestick.sh',    "$gpui/src/component_shell/chart/mod.cpp", 'typephp-gpui: candlestick chart'],
        ['patch-sankey.sh',         "$gpui/src/component_shell/chart/mod.cpp", 'typephp-gpui: sankey chart'],
        ['patch-searchable-list.sh', "$gpui/src/component_shell/delegate_collections/mod.cpp", 'RegisterSearchableList'],
        ['patch-text-effects.sh',   "$gpui/src/component_shell/controls/text.cpp", 'ComponentDescriptor kTypewriter'],
    ];
}

/** 从 marker 表派生"要跑哪些补丁脚本"——执行清单与校验清单从此是同一份数据。
 *  以前 composer.json 8 支、bin/gpui 11 支、GPUI.lock 写 7 个，单跑 `composer patch`
 *  得到半补丁树，缺的正是防 key_down 段错误的 patch-key-view.sh。 */
function patchScripts(): array
{
    $out = [];
    foreach (patchManifest() as $row) {
        if (!in_array($row[0], $out, true)) {
            $out[] = $row[0];
        }
    }
    return $out;
}

// 校验所有补丁 marker 就位；全在返回 true，否则逐条报缺。
function verifyPatches(): bool {
    $all = true;
    foreach (patchManifest() as [$script, $file, $marker]) {
        if (!is_file($file)) { bad("{$script}：目标文件缺失 {$file}"); $all = false; continue; }
        $hit = trim((string) @shell_exec('grep -qF ' . escapeshellarg($marker) . ' ' . escapeshellarg($file) . ' && echo Y'));
        if ($hit === 'Y') { ok("$script 已落（" . basename($file) . "）"); }
        else { bad("{$script} 未落：{$file} 缺 marker「{$marker}」"); $all = false; }
    }
    return $all;
}

/**
 * 把裸可执行文件包成最小 .app bundle，返回 bundle 里的可执行路径。
 *
 * 为什么必须包：macOS 只把"有 bundle 身份"的进程当正规前台应用。裸二进制即使
 * TransformProcessType + activateIgnoringOtherApps 全部调过，NSApp.isActive 仍是
 * false、窗口拿不到 keyWindow——于是手点的第一下被当成"激活你这扇窗口"吃掉，
 * keyDown 更根本没有 firstResponder 可去。画面上就是"点了没反应、输入框打不进字"。
 * 同一颗二进制放进 bundle 后读数翻成 active=true key=true main=true。
 *
 * 主可执行文件放**正规文件**（先试硬链接，链接不可用就复制——本机实测走到复制），
 * 不用符号链接：`codesign` 拒绝签主可执行文件是符号链接的 bundle
 * （"the main executable or Info.plist must be a regular file"），而签名没把 Info.plist 绑进去
 * 的 bundle 应用拿不到 WindowServer 的**在屏**资格
 * ——实测三种组合：符号链接（签不了）/ 真文件未签 / 硬链接未签 ⇒ `windowState()['onScreen']`
 * 恒 false，窗口在窗口服务里有号、有画面，却从不上屏，于是真人键盘鼠标零送达；
 * 只有"硬链接 + `codesign -s - --force`（Info.plist entries 进签名）"⇒ onScreen=true。
 * 每次 build 都重建这条链接，所以不会指向旧产物。
 */
function appBundle(string $root, string $example): string
{
    $bin = "$root/examples/$example/build/$example";
    $appDir = "$root/examples/$example/build/$example.app";
    $macos = "$appDir/Contents/MacOS";
    if (!is_dir($macos) && !mkdir($macos, 0755, true) && !is_dir($macos)) {
        err("无法创建 bundle 目录：$macos");
        exit(1);
    }
    $link = "$macos/$example";
    if (is_link($link) || is_file($link)) {
        @unlink($link);
    }
    if (!@link($bin, $link) && !copy($bin, $link)) {
        err("无法把可执行文件放进 bundle：$link");
        exit(1);
    }
    @chmod($link, 0755);

    // 交付身份（bundle id / 名称 / 版本 / 图标）来自 example 自己的 project.macos.yml，
    // 缺省值等于这里原先的硬编码——所以没写这三项的示例行为一点没变。解析在
    // cmd/bundle-identity.php（纯函数、可单测），这里只负责填 plist 与搬图标。
    $id = bundle_identity("$root/examples/$example");
    foreach ($id['warnings'] as $w) {
        err("bundle 身份：$w");
    }
    $iconPlist = '';
    if ($id['icon_src'] !== null) {
        // 目标名是库里净化过的 basename（路径里的 ../ 逃不出 bundle 外）。
        $resources = "$appDir/Contents/Resources";
        if (!is_dir($resources) && !mkdir($resources, 0755, true) && !is_dir($resources)) {
            err("无法创建 Resources 目录：$resources");
            exit(1);
        }
        if (!copy($id['icon_src'], "$resources/{$id['icon_name']}")) {
            err("图标复制失败：{$id['icon_src']}（bundle 将无图标）");
        } else {
            $iconPlist = "\n<key>CFBundleIconFile</key><string>{$id['icon_name']}</string>";
        }
    }

    file_put_contents("$appDir/Contents/Info.plist", <<<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>$example</string>
<key>CFBundleIdentifier</key><string>{$id['id']}</string>
<key>CFBundleName</key><string>{$id['name']}</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>{$id['version']}</string>$iconPlist
<key>LSMinimumSystemVersion</key><string>11.0</string>
<key>NSHighResolutionCapable</key><true/>
<key>NSPrincipalClass</key><string>NSApplication</string>
</dict></plist>

PLIST);
    // 绑上 Info.plist 的签名才拿得到在屏资格（见函数头）。没有 codesign（非 mac 或
    // 裁掉工具链）不阻断构建，但必须出声——静默产出一个"点不动"的 bundle 比报错难查得多。
    $signOut = [];
    $signRc = 0;
    @exec('codesign -s - --force ' . escapeshellarg($appDir) . ' 2>&1', $signOut, $signRc);
    if ($signRc !== 0) {
        err('bundle 未签名（codesign rc=' . $signRc . '：' . ($signOut[0] ?? '无输出')
            . '）——窗口可能拿不到在屏资格：真人键鼠零送达，见 windowState()[\'onScreen\']。');
    }
    return $link;
}

switch ($cmd) {
    case 'doctor': {
        out('TypePHP-GPUI 工具链检查');
        which('bun') ? ok('bun: ' . which('bun')) : bad('bun 未找到（生成 gpui-kit-cpp amalgam 需要）');
        which('clang++') ? ok('clang++: ' . which('clang++')) : bad('clang++ 未找到');
        $tpc = is_file("$root/vendor/bin/tpc.php") ? "$root/vendor/bin/tpc.php" : null;
        $tpc ? ok('tpc: ' . $tpc) : bad('tpc 未找到（composer install）');
        is_dir("$root/vendor/swoole/php-nano") ? ok('php-nano 已装') : bad('php-nano 未装（composer require swoole/php-nano）');
        $gpui = gpuiDir();
        is_dir($gpui) ? ok("gpui-kit-cpp 源码就位：$gpui") : bad("gpui-kit-cpp 未就位（{$gpui}；或设 GPUI_DIR）");
        // 漂移警报：cmd/ 下每支 patch-*.sh 都必须出现在清单里。漏登记的新补丁
        // 不会报错、也不会被跑到——正是"半补丁树"的来路。
        $listed = patchScripts();
        foreach (glob("$root/cmd/patch-*.sh") ?: [] as $path) {
            $name = basename($path);
            in_array($name, $listed, true)
                ? ok("清单收录：$name")
                : bad("$name 存在于 cmd/ 但不在补丁清单里（永远不会被跑到）");
        }
        // 防火墙的主张是「gpui_shim.h 只有 C」。这句话现在没人守着：头里漏进
        // 一个 std:: 或 C++ 头，报错要晚到几分钟后的链接期。跑一下门脚本。
        $cAbi = run('bash ' . escapeshellarg("$root/cmd/check-c-abi.sh"));
        $cAbi === 0 ? ok('gpui_shim.h 纯 C 编译通过') : bad('gpui_shim.h 不再是纯 C（C ABI 防火墙漏了）');
        out('补丁落位校验：');
        verifyPatches();
        // doctor 的产物必须是退出码：以前它把 ✗ 打出来照样返回 0，于是
        // `gpui doctor && <下一步>` 在缺工具链/半补丁的机器上照样往下走。
        exit(($GLOBALS["gpui_bad_n"] ?? 0) > 0 ? 1 : 0);
        break;
    }

    case 'build':
    case 'run':
    case 'shot':
    case 'selftest': {
        $example = $args[0] ?? 'hello';
        $yml = "$root/examples/$example/project.macos.yml";
        if (!is_file($yml)) { err("找不到示例配置：$yml"); exit(1); }

        // 1a) 先把 vendored 的 upstream/ 复制成构建沙箱：补丁、amalgam、out 全落沙箱，
        //     跟踪的源码树不被弄脏。顺序要紧——补丁要在沙箱存在之后才找得到文件。
        //
        // --no-native 跳过共用的前三步（同步→补丁→amalgam→shim 库），只跑 tpc 那一步。
        // 它现在是"只改了 PHP"的快路径，不再是"避免重编"的开关：cmd/sync-upstream.sh 有
        // 上游指纹闸门，上游没变就整个跳过同步，.work/ 与 out/ 不会被删，amalgam 于是命中
        // 增量（2026-10-19 实测完整链 6.52s：sync 0.10 + patch 1.27 + amalgam 1.41
        // + shim 3.40 + tpc 2.08 + bundle ~0.2）。留给它的位置是连 shim 那 3.40s 也不想再付时
        // （每支约 2s，见 cmd/all-examples.sh 的批量跑法）。它只在"本轮已经建过共享产物"时成立，
        // 所以下面先验那两个文件在不在——宁可拒绝，也不要静默链接到陈旧产物上量出一个假绿。
        $noNative = in_array('--no-native', $args, true);
        $gpui = gpuiDir();
        $gpuiO = "$gpui/out/mac/rel/obj/gpui/gpui.o";
        $shimA = "$root/cpp-src/build/libgpui_shim.a";
        if (!$noNative) {
            $rc = run("bash $root/cmd/sync-upstream.sh");
            if ($rc !== 0) { err('同步 upstream 失败'); exit($rc); }

            // 1) 补丁（幂等）——含 Stage D 的 registered-cb。
            foreach (patchScripts() as $p) {
                $rc = run("bash $root/cmd/$p");
                if ($rc !== 0) { err("补丁失败：$p"); exit($rc); }
            }
            // 1b) 校验全部补丁落位，缺则中止（防半补丁 amalgam）。
            if (!verifyPatches()) { err('补丁未全部落位，中止'); exit(1); }
            // 2) 生成 amalgam + 编译对象（gpui-kit-cpp 自带构建）
            // hello_world 的链接会因入口 main 被改名而失败（预期，GPUI.lock 构建链节
            // 有明文）——这五行报错是每轮构建的固定噪音，不是故障：原样透传会让
            // 上层按输出扫 "error" 的门禁误报（2026-10-31 实测）。这里抓输出、按
            // cmd/expected-hello-world-link-noise.txt 滤掉恰好这五行再透传（模式放
            // 文件里，run() 的命令回显不会把报错串又带进输出）；失败判定仍然只看
            // gpui.o 在不在（下面那行），bun 的真实失败（编译错等）不受过滤影响。
            $rc = run("cd " . escapeshellarg($gpui)
                . " && bun cmd/build.ts -rel hello_world 2>&1 | grep -v -F -f "
                . escapeshellarg("$root/cmd/expected-hello-world-link-noise.txt"));
            // hello_world 的链接会因入口 main 被改名而失败（预期），只要 gpui.o 新即可。
            if (!is_file($gpuiO)) { err('amalgam 对象未生成：' . $gpuiO); exit(1); }
            // 3) 建 shim 静态库
            $rc = run("bash $root/cmd/build-shim.sh");
            if ($rc !== 0) { err('build-shim 失败'); exit($rc); }
        } else {
            $miss = [];
            foreach ([$gpuiO, $shimA] as $need) {
                if (!is_file($need)) { $miss[] = $need; }
            }
            if ($miss !== []) {
                err("--no-native 要的前置产物不在：" . implode(' ', $miss)
                    . '（先用不带该开关的 gpui build 跑一遍完整链）');
                exit(1);
            }
            out('--no-native：沿用已建好的共享产物（' . basename($gpuiO) . ' + '
                . basename($shimA) . '），只编译本示例');
        }
        // 4) tpc nano 编译示例。yml 里 @ROOT@ → 绝对仓库根（shim .a 需绝对路径，
        //    tpc 不解析相对 ld-flags）；解析后的副本落在同目录，相对 sources 路径不受影响。
        $resolved = str_replace('@ROOT@', $root, (string) file_get_contents($yml));
        $genYml = dirname($yml) . '/project.macos.gen.yml';
        file_put_contents($genYml, $resolved);
        $rc = run("php $root/vendor/bin/tpc.php " . escapeshellarg($genYml) . " --nano");
        if ($rc !== 0) { err('tpc 编译失败'); exit($rc); }
        $bin = "$root/examples/$example/build/$example";
        ok("构建完成：$bin");
        if ($cmd === 'build') {
            // bundle 里放的是硬链接而不是符号链接（见 appBundle 的头），它不会像 symlink
            // 那样自动跟到新产物上——重链换了 inode，bundle 里就还是那颗旧的。所以 build
            // 也要立刻刷新 bundle，否则"`build` 之后直接跑 .app"会静默跑旧二进制。
            appBundle($root, $example);
        }

        if ($cmd === 'run') {
            $exe = appBundle($root, $example);
            ok("已包成 bundle（产物身份用）：$exe");
            /* 默认跑**裸二进制**，不再默认跑 bundle 里那一颗。
             * 实测（同一秒、同一份字节、同一台机器）：
             *   裸：  onScreen=true  active=true key=true bundled=false
             *   bundle：onScreen=false active=true key=true bundled=true
             * 也就是说 bundle 那一颗的窗口根本不被 WindowServer 合成——人看不见、
             * 也按不动，而这正是 `run` 这个交互入口唯一要给出的东西。
             * （旧结论"裸二进制起不来 isActive"是前台重试那条补丁之前量的，已不成立：
             * 这一行同时纠正 docs 里"run 必须走 bundle"的说法。）
             * 需要验证 bundle 身份本身时用 `--bundle` 显式走那条路（selftest 的
             * `--expect-bundle` 仍固定走 bundle，那是产物属性断言，不是交互验收）。 */
            if (!in_array('--bundle', array_slice($args, 1), true)) {
                $exe = $bin;
            }
            out('执行：' . $exe . (in_array('--bundle', array_slice($args, 1), true)
                ? '（bundle 路径：窗口可能不被合成）' : '（裸二进制路径：窗口可合成）'));
            // 把示例自己的开关（--trace / --sections / --selftest）原样转给产物：
            // 没有这条转发，"php bin/gpui run input --trace" 会静默丢掉 trace，
            // 而那正是量"手点有没有到"的唯一外部手段。
            $extra = array_values(array_filter(array_slice($args, 1),
                static fn ($a): bool => $a !== '--no-native' && $a !== '--bundle'));
            $quoted = [];
            foreach ($extra as $a) {
                $quoted[] = escapeshellarg((string) $a);
            }
            exit(run(escapeshellarg($exe) . ($quoted ? ' ' . implode(' ', $quoted) : '')));
        }
        if ($cmd === 'shot') {
            $path = $args[1] ?? "/tmp/$example.png";
            $tree = $args[2] ?? null;
            $line = escapeshellarg($bin) . ' --shot ' . escapeshellarg($path);
            if ($tree !== null) {
                $line .= ' ' . escapeshellarg((string) (int) $tree);
            }
            exit(run($line));
        }
        if ($cmd === 'selftest') {
            // 走 bundle，并用这个环境变量把"我期望自己是 bundle 起的"告诉产物：
            // selftest 于是能硬断言 bundled=true（这是产物属性，我们能保证），
            // 而 frontmost 只作读数报告——前台是 OS 跟焦点持有者竞争出来的，
            // 后台 shell 里 macOS 会正当拒绝抢焦点，拿它当硬门就变成随机红灯。
            // 信号必须走 argv：nano 不支持 getenv()，环境变量在编译期就过不去。
            exit(run(escapeshellarg(appBundle($root, $example))
                . ' --selftest --expect-bundle'));
        }
        break;
    }

    case 'shotdiff': {
        // gpui shotdiff [check|record] [example]  —— --shot 视觉回归基线比对（需已构建）
        $mode = $args[0] ?? 'check';
        $ex = $args[1] ?? 'hello';
        exit(run('php ' . escapeshellarg("$root/cmd/shotdiff.php") . ' '
            . escapeshellarg($mode) . ' ' . escapeshellarg($ex)));
    }

    case 'patch': {
        // 唯一的补丁入口：composer 与 bin/gpui build 都走这里，清单只有一份。
        foreach (patchScripts() as $p) {
            $script = "$root/cmd/$p";
            if (!is_file($script)) { err("补丁脚本缺失：$script"); exit(1); }
            $rc = run('bash ' . escapeshellarg($script));
            if ($rc !== 0) { err("补丁失败：$p"); exit($rc); }
        }
        exit(verifyPatches() ? 0 : 1);
    }

    case 'new': {
        $app = $args[0] ?? '';
        if ($app === '') { err('用法：gpui new <app>'); exit(1); }
        $dir = getcwd() . "/$app";
        if (is_dir($dir)) { err("已存在：$dir"); exit(1); }
        mkdir("$dir/src", 0755, true);
        $yml = str_replace('gpui-hello', "gpui-$app", file_get_contents("$root/examples/hello/project.macos.yml"));
        // 交付身份三项连注释一起写进脚手架：没注释的键等于不存在，新人不会知道能配。
        $yml = (string) preg_replace(
            '/^name: .*$/m',
            "name: gpui-$app\n\n"
            . "# 交付身份（都可选；缺省值见 cmd/bundle-identity.php）：\n"
            . "#   bundle-id:     com.example.$app\n"
            . "#   bundle-name:   $app\n"
            . "#   bundle-version: 1.0.0\n"
            . "#   icon:          assets/App.icns   # 发布质量用 .icns，.png 开发期也收",
            $yml,
            1
        );
        file_put_contents("$dir/project.macos.yml", $yml);
        file_put_contents("$dir/src/main.php", <<<PHP
<?php

declare(strict_types=1);

use TypePHP\\Gpui\\App;
use TypePHP\\Gpui\\Element as El;

function main(int \$argc, array \$argv): void
{
    \$app = new App();
    \$app->run('$app', 800, 600, function (): El {
        return El::vFlex([El::text('Hello from $app!')->font(24.0)->semibold()])
            ->sizeFull()->itemsCenter()->justifyCenter();
    });
}
PHP);
        ok("已生成脚手架：$dir");
        out("  下一步：把 $app 放进 examples/ 或调整 yml 路径后 gpui build");
        break;
    }

    default:
        out(<<<H
gpui — TypePHP-GPUI 打包 CLI

  gpui doctor              检查工具链
  gpui build [example]     补丁→amalgam→shim 库→tpc nano 编译（加 --no-native 只跑 tpc）
  gpui run [example]       编译并运行（默认 hello）
  gpui shot [example]      编译并截图出 PNG
  gpui selftest [example]  编译并跑 --selftest
  gpui shotdiff [check|record] [example]  --shot 视觉回归基线比对（需已构建）
  gpui new <app>           脚手架新应用
H);
}
